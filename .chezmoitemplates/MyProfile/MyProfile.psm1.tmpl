{{- $isPSCore := hasPrefix "core" ( base .chezmoi.sourceFile ) -}}
{{- $isPagingAvailable := false -}}
{{- if $isPSCore -}}
    {{- $textMagePagingSupportCommandCheck := "$PSVersionTable.PSVersion -ge ([version]'7.4.0') ? ( Get-Module -Name TextMate -ListAvailable | Where-Object -FilterScript { $_.Version -ge ([version]'0.2.1') } ) : $null" -}}
    {{- if ( output "pwsh" "-NoProfile" "-NoLogo" "-Command" $textMagePagingSupportCommandCheck ) -}}
        {{- $isPagingAvailable = true -}}
    {{- end -}}
{{- end -}}
{{- $tmplDict := mustMerge . ( dict 
        "isPSCore" $isPSCore
        "isPagingAvailable" $isPagingAvailable
    )
-}}
{{- range $file := glob ( joinPath .chezmoi.sourceDir ".chezmoitemplates" "MyProfile" "**" "{*.ps1,*.ps1.tmpl}" ) -}}
    {{- $currentIsTmpl := hasSuffix ".tmpl" $file -}}
    {{- $currentParentDir := osBase ( osDir $file ) -}}
    {{- $currentIsParentDirCore := eq $currentParentDir "core" -}}
    {{- $currentIsParentDirDesktop := eq $currentParentDir "desktop" -}}
    {{- $currentIsBoth := and ( not $currentIsParentDirCore ) ( not $currentIsParentDirDesktop ) -}}
    {{- $currentIsCoreOnly := and ( eq $currentParentDir "core" ) $isPSCore -}}
    {{- $currentIsDesktopOnly := and ( eq $currentParentDir "desktop" ) ( not $isPSCore ) -}}
    {{- if $currentIsBoth -}}
        {{- if $currentIsTmpl -}}
            {{- includeTemplate $file $tmplDict -}}
            {{- print $.lineEnding -}}
        {{- else -}}
            {{- include $file -}}
            {{- print $.lineEnding -}}
        {{- end -}}
    {{- else -}}
        {{- if or $currentIsDesktopOnly $currentIsCoreOnly -}}
            {{- if $currentIsTmpl -}}
                {{- includeTemplate $file $tmplDict -}}
                {{- print $.lineEnding -}}
            {{- else -}}
                {{- include $file -}}
                {{- print $.lineEnding -}}
            {{- end -}}
        {{- end -}}
    {{- end -}}
{{- end -}}

