@{
    RootModule = $(
        # chezmoi if windows {{- if .isWindows }}
        if ($PSEdition -eq 'Core') {
            'core.psm1'
        }
        else {
            'desktop.psm1'
        }
        # else *nix/mac {{- else }}{{ includeTemplate "tools/WriteOsAwareNIndent.tmpl" ( dict "lineEnding" .lineEnding "width" 4 "string" ( squote "core.psm1" ) ) }}{{ end }}
    ) 
    ModuleVersion = '0.1.0'
    CompatiblePSEditions = @(
        # chezmoi if windows {{- if .isWindows }}
        'Desktop'
        'Core'
        # else *nix/mac {{- else }}{{ includeTemplate "tools/WriteOsAwareNIndent.tmpl" ( dict "lineEnding" .lineEnding "width" 4 "string" ( squote "Core" ) ) }}{{ end }}
    )
    GUID = '403248e3-3cb7-4192-b32b-77d104ee14e2'
    Author = 'Matthew Cargile'
    CompanyName = 'Matthew Cargile'
    Copyright = '(c) Matthew Cargile. All rights reserved.'
    Description = 'Personal Module For Profile'
    PowerShellVersion =
        # chezmoi if windows {{- if .isWindows }}
        '5.1'
        # else *nix/mac {{- else }}{{ includeTemplate "tools/WriteOsAwareNIndent.tmpl" ( dict "lineEnding" .lineEnding "width" 4 "string" ( squote "7.5.4" ) ) }}{{ end }}
    TypesToProcess = @(
        '.\MyProfile.types.ps1xml'
    )
    FormatsToProcess = @(
        '.\MyProfile.format.ps1xml'
    )
    NestedModules = @(
        # chezmoi if windows {{- if .isWindows }}
        if ($PSEdition -eq 'Core') {
            '.\lib\core\MyProfileLib.dll'
        }
        else {
            '.\lib\desktop\MyProfileLib.dll'
        }
        # else *nix/mac {{- else }}{{ includeTemplate "tools/WriteOsAwareNIndent.tmpl" ( dict "lineEnding" .lineEnding "width" 4 "string" ( joinPath "." "lib" "core" "MyProfileLib.dll" | squote ) ) }}{{ end }}
    )
    # chezmoi get functions and aliases {{- $funcCmdletAliasOutJson := output "pwsh" "-NoLogo" "-NoProfile" "-File" ( joinPath .chezmoi.sourceDir ".chezmoitemplates" "tools" "Write-MyProfileFuncCmdletAliasExportJson.ps1" ) | fromJson }}
    FunctionsToExport = @(
        # chezmoi if all functions {{- range $currentAllFunc := $funcCmdletAliasOutJson.All.Function }}{{ includeTemplate "tools/WriteOsAwareNIndent.tmpl" ( dict "lineEnding" $.lineEnding "width" 8 "string" ( $currentAllFunc | squote ) ) }}{{ end }}
        if ($PSEdition -eq 'Core') {
            # chezmoi if core functions {{- range $currentAllFunc := $funcCmdletAliasOutJson.Core.Function }}{{ includeTemplate "tools/WriteOsAwareNIndent.tmpl" ( dict "lineEnding" $.lineEnding "width" 12 "string" ( $currentAllFunc | squote ) ) }}{{ end }}
        }
        else {
            # chezmoi if desk functions {{- range $currentAllFunc := $funcCmdletAliasOutJson.Desktop.Function }}{{ includeTemplate "tools/WriteOsAwareNIndent.tmpl" ( dict "lineEnding" $.lineEnding "width" 12 "string" ( $currentAllFunc | squote ) ) }}{{ end }}
        }
    )
    CmdletsToExport = @(
        # chezmoi if all cmdlets {{- range $currentAllCmdlet := $funcCmdletAliasOutJson.All.Cmdlet }}{{ includeTemplate "tools/WriteOsAwareNIndent.tmpl" ( dict "lineEnding" $.lineEnding "width" 8 "string" ( $currentAllCmdlet | squote ) ) }}{{ end }}
    )
    VariablesToExport = @()
    AliasesToExport = @(
        # chezmoi all aliases {{- range $currentAllAlias := $funcCmdletAliasOutJson.All.Alias }}{{ includeTemplate "tools/WriteOsAwareNIndent.tmpl" ( dict "lineEnding" $.lineEnding "width" 8 "string" ( $currentAllAlias | squote ) ) }}{{ end }}
        if ($PSEdition -eq 'Core') {
            # chezmoi if core functions {{- range $currentAllFunc := $funcCmdletAliasOutJson.Core.Alias }}{{ includeTemplate "tools/WriteOsAwareNIndent.tmpl" ( dict "lineEnding" $.lineEnding "width" 12 "string" ( $currentAllFunc | squote ) ) }}{{ end }}
        }
        else {
            # chezmoi if desk functions {{- range $currentAllFunc := $funcCmdletAliasOutJson.Desktop.Alias }}{{ includeTemplate "tools/WriteOsAwareNIndent.tmpl" ( dict "lineEnding" $.lineEnding "width" 12 "string" ( $currentAllFunc | squote ) ) }}{{ end }}
        }
    ) 
    PrivateData = @{
        PSData = @{
            Tags = 'profile', 'personal'
        }
    }
}

